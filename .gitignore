# Godot 4+ specific ignores
.godot/
/android/

# Exported builds
build/
*.exe
*.x86_64
*.pck

# OS / IDE
.DS_Store
Thumbs.db
.vscode/

# Blender backup files
*.blend1
*.blend2

# Teamwork Multi-Agent traces
.agents/
*:Zone.Identifier

# Review / scratch output
tmp/

# Written by the build pipeline; the version lives in project.godot
version.json

# Playtest frames (tools/playtest.gd). Pictures of a game that changes daily do not
# belong in history -- regenerate them instead.
screenshots/

# Whole faces the shipped ones are cut from (tools/subset_fonts.py): 25 MB of Chinese for
# the few hundred characters the game says. The cut is in assets/fonts; the source says
# where to get it again.
tools/font_sources/

# Python bytecode from running the tools/ generators
__pycache__/
*.pyc
